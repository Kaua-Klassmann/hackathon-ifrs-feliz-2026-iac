        <mxCell id="leg-2-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Push da imagem&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Pipeline do hackathon-api builda e envia a imagem pro ECR compartilhado, tag imutavel = github.sha.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-2"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
