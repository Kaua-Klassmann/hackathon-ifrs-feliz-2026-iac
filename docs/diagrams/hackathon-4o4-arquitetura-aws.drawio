        <mxCell id="leg-1-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="leg-1"><mxGeometry height="38" width="40" y="-18.0" as="geometry" x="-50.0" /></mxCell>
        <mxCell id="leg-1-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Autenticacao OIDC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;GitHub Actions assume a role IAM do ambiente via OIDC — sem access keys; trust por sub=environment:prod.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-1"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
        <mxCell id="leg-2" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="78" width="578" x="0" y="82" as="geometry" /></mxCell>
        <mxCell id="leg-2-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="leg-2"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-30.0" /></mxCell>
        <mxCell id="leg-2-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Push da imagem&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Pipeline do hackathon-api builda e envia a imagem pro ECR compartilhado, tag imutavel = github.sha.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-2"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
