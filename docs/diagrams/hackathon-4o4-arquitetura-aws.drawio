        <mxCell id="leg-3-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Migration como task avulsa&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Pipeline registra a task definition e roda ecs run-task com comando migration up antes do deploy; exit code != 0 aborta.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-3"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
