        <mxCell id="leg-10-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="10" vertex="1" parent="leg-10"><mxGeometry height="38" width="40" y="2.0" as="geometry" x="-30.0" /></mxCell>
        <mxCell id="leg-10-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;ECS -&gt; Valkey&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Cache em subnet isolada, TLS at-rest e in-transit; mesmo modelo de SG.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-10"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
