        <mxCell id="leg-1-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Autenticacao OIDC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;GitHub Actions assume a role IAM do ambiente via OIDC — sem access keys; trust por sub=environment:dev.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-1"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
