        <mxCell id="leg-12-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Senha do banco&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Execution role le o secret gerenciado do RDS (manage_master_user_password) e injeta DB_PASSWORD.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-12"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
        <mxCell id="leg-13" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="78" width="578" x="0" y="984" as="geometry" /></mxCell>
        <mxCell id="leg-13-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="13" vertex="1" parent="leg-13"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="leg-13-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Landing estatica&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;dev.4o4.com.br via CloudFront com OAC; bucket S3 privado; erro 403 vira 404.html.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-13"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
        <mxCell id="leg-14" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="78" width="578" x="0" y="1066" as="geometry" /></mxCell>
        <mxCell id="leg-14-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="14" vertex="1" parent="leg-14"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="leg-14-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;App Next.js&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;app.dev.4o4.com.br no Amplify Hosting (SSR), branch develop com auto-build.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-14"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
        <mxCell id="leg-15" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="78" width="578" x="0" y="1148" as="geometry" /></mxCell>
        <mxCell id="leg-15-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="15" vertex="1" parent="leg-15"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="leg-15-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Acesso administrativo&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Bastion sem IP publico e sem ingress; tunel via SSM Session Manager ate RDS/Valkey (auditado no CloudTrail).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-15"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
        <mxCell id="footer-obs" value="OBSERVACOES (recursos do codigo sem seta propria): bucket S3 do tfstate (bootstrap/, backend do Terraform, fora do fluxo de runtime); certificado ACM wildcard *.dev.4o4.com.br validado por DNS (anexado ao ALB); registros Route 53 de validacao ACM, DKIM x3, SPF, DMARC e NS de delegacao; IAM roles de runtime (execution/task do ECS, CodeDeploy, instance profile do bastion) representadas nos proprios servicos; autoscaling target tracking (CPU 70%) e dashboard CloudWatch agregados ao icone do CloudWatch; OIDC provider do GitHub (stacks/shared/oidc) representado no icone de roles IAM; lifecycle policy do ECR (untagged 7d / keep 20)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="1470" width="1380" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
