        <mxCell id="leg-7-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;API via ALB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;api.4o4.com.br em HTTPS (ACM wildcard); listener 80 so redireciona pro 443.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-7"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
