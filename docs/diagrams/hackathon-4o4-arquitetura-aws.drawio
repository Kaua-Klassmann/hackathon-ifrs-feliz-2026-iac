        <mxCell id="leg-4-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Deploy Blue/Green&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Pipeline cria o deployment no CodeDeploy, que troca o trafego entre target groups blue/green (canario 10% por 5 min).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="leg-4"><mxGeometry height="78" width="524" x="52" as="geometry" /></mxCell>
